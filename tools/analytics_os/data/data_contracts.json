{
  "schema": "analytics_os.data_contracts.v1",
  "version": "1.0",
  "note": "8 producer→consumer dataset contracts. Analytics OS is the consumer; producers are domain OS. Snapshots are synthetic/local in this build (no live canonical read).",
  "contracts": [
    {"dataset": "mc_operational_snapshot", "producer": "Master_Controller", "consumer": "Analytics_OS", "schema_version": "1.0", "fields": ["snapshot_id", "lead_counts_by_status", "send_counts", "test_only_send_counts", "backup_health"], "status_semantics": "CONFIRMED operational", "freshness": "live (synthetic here)", "quality_rules": ["completeness", "freshness", "no_test_in_commercial"], "sensitivity": "IDS_ONLY", "retention": "90d snapshots", "breaking_change_policy": "review + deprecation window"},
    {"dataset": "rev_funnel_snapshot", "producer": "Revenue_OS", "consumer": "Analytics_OS", "schema_version": "1.0", "fields": ["snapshot_id", "stages", "stage_counts", "product_id", "expected_deals"], "status_semantics": "MODEL_ESTIMATE", "freshness": "monthly", "quality_rules": ["monotonic_funnel", "completeness"], "sensitivity": "AGGREGATE", "retention": "24 periods", "breaking_change_policy": "additive only without review"},
    {"dataset": "del_project_snapshot", "producer": "Delivery_OS", "consumer": "Analytics_OS", "schema_version": "1.0", "fields": ["snapshot_id", "project_id", "state", "start_date", "accepted_date", "qa_result", "rework_count"], "status_semantics": "CONFIRMED", "freshness": "live (synthetic here)", "quality_rules": ["referential_integrity:deal_id", "validity:state_enum"], "sensitivity": "IDS_ONLY", "retention": "live + 24 periods", "breaking_change_policy": "review"},
    {"dataset": "fin_period_snapshot", "producer": "Finance_OS", "consumer": "Analytics_OS", "schema_version": "1.0", "fields": ["snapshot_id", "period", "booked_revenue", "invoiced", "collected", "overdue", "operating_result"], "status_semantics": "mixed CONFIRMED/MODEL_ESTIMATE", "freshness": "monthly", "quality_rules": ["consistency:booked>=collected", "completeness"], "sensitivity": "AGGREGATE", "retention": "permanent (period close)", "breaking_change_policy": "review"},
    {"dataset": "prod_readiness_snapshot", "producer": "Product_OS", "consumer": "Analytics_OS", "schema_version": "1.0", "fields": ["snapshot_id", "product_id", "state", "readiness_dimensions", "pilot_outcomes", "claims"], "status_semantics": "MODEL_ESTIMATE", "freshness": "snapshot", "quality_rules": ["validity:state_enum", "semantic:active_requires_readiness"], "sensitivity": "AGGREGATE", "retention": "24 periods", "breaking_change_policy": "review"},
    {"dataset": "cs_portfolio_snapshot", "producer": "Customer_Success_OS", "consumer": "Analytics_OS", "schema_version": "1.0", "fields": ["snapshot_id", "customer_ref_id", "status", "health", "adoption", "open_support", "renewal_eligible"], "status_semantics": "derived", "freshness": "snapshot", "quality_rules": ["referential_integrity:project_id", "validity:health_enum"], "sensitivity": "IDS_ONLY", "retention": "live + 24 periods", "breaking_change_policy": "review"},
    {"dataset": "exec_decision_snapshot", "producer": "Executive_OS", "consumer": "Analytics_OS", "schema_version": "1.0", "fields": ["snapshot_id", "decision_id", "status", "category", "age_days"], "status_semantics": "derived", "freshness": "snapshot", "quality_rules": ["validity:status_enum"], "sensitivity": "AGGREGATE", "retention": "24 periods", "breaking_change_policy": "review"},
    {"dataset": "hq_project_task_snapshot", "producer": "AI_HQ", "consumer": "Analytics_OS", "schema_version": "1.0", "fields": ["snapshot_id", "project_id", "state", "task_counts"], "status_semantics": "CONFIRMED", "freshness": "snapshot", "quality_rules": ["uniqueness:project_id", "validity:state_enum"], "sensitivity": "AGGREGATE", "retention": "24 periods", "breaking_change_policy": "review"}
  ]
}
