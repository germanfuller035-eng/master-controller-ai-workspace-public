  "android_reconciliation": {
    "note": "MP23 — Android DTO/repository vs MC API + OS read models. No Android code changed; no new APK/AAB.",
    "findings": [
      { "dto": "LeadDto", "vs": "mc.lead.read", "issue": "revision field presence — must carry canonical revision for 409 handling", "severity": "HIGH", "action": "ADD_FIELD_PROPOSAL revision:int" },
      { "dto": "ApprovalDto", "vs": "mc.approval.command", "issue": "idempotency_key must be sent on approve/reject", "severity": "HIGH", "action": "ADD_FIELD_PROPOSAL idempotency_key" },
      { "dto": "PipelineStageDto", "vs": "lead status enum", "issue": "enum must match canonical lead statuses exactly (no client-invented states)", "severity": "MEDIUM", "action": "ENUM_ALIGN_PROPOSAL" },
      { "dto": "Room cache", "vs": "cache_standard", "issue": "Room is a cache, never canonical; must carry stale indicator + TTL + no offline mutation", "severity": "HIGH", "action": "CACHE_POLICY_PROPOSAL" },
      { "dto": "timestamps", "vs": "temporal_standard", "issue": "must store UTC ISO; convert at display only", "severity": "MEDIUM", "action": "TEMPORAL_ALIGN_PROPOSAL" }
    ],
    "offline_write_risk": "Room must NOT accept offline mutations of canonical entities; queue-as-intent only with idempotency_key, applied online via MC command."
  },

  "telegram_reconciliation": {
    "note": "MP24 — Telegram client/views vs MC API + Executive + Conversation Hub inbox. No deployment.",
    "findings": [
      { "view": "approval card", "issue": "must use buttons (callback) not command strings; callback must carry revision + idempotency_key", "severity": "HIGH", "action": "CALLBACK_REVISION_PROPOSAL" },
      { "view": "lead/reply display", "issue": "must show canonical IDs, not raw internal objects or raw enums", "severity": "MEDIUM", "action": "VIEW_MAPPING_PROPOSAL" },
      { "risk": "direct local fallback", "issue": "owner-control Telegram must not have a direct local file/SMTP fallback path", "severity": "HIGH", "action": "REMOVE_FALLBACK_PROPOSAL (owner review)" },
      { "risk": "mutation without idempotency", "issue": "any send/approve callback must be idempotent", "severity": "HIGH", "action": "IDEMPOTENCY_PROPOSAL" }
    ]
  },

