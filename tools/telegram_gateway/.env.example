# Telegram Master Controller — пример .env
# Скопируй этот файл в .env и вставь свои значения.
# НЕ коммить .env в git — токен должен быть только у тебя.

# Обязательно: токен бота от BotFather
TELEGRAM_BOT_TOKEN=PASTE_YOUR_BOTFATHER_TOKEN_HERE

# Рекомендуется: твой chat_id (узнать через @userinfobot)
TELEGRAM_CHAT_ID=YOUR_CHAT_ID_HERE

# Опционально: admin chat id (если отличается)
TELEGRAM_ADMIN_CHAT_ID=YOUR_CHAT_ID_HERE

# Опционально: разрешённые user_id через запятую
ALLOWED_TELEGRAM_USER_IDS=YOUR_USER_ID_HERE
