# ============================================================
# AI_WORKSPACE .gitignore
# Updated: 2026-05-26 — Git Hygiene Audit
# Backup: .gitignore.bak_2026-05-26
# ============================================================

# --- Secrets: never commit any .env ---
.env
.env.*
*.env
**/.env

# Project-specific .env locations (explicit for safety)
tools/communication_monitor/.env
tools/telegram_gateway/.env
13_sales/daily_lead_factory/.env

# --- Secrets: SSH keys, certificates, private keys ---
*.pem
*.key
id_rsa*
id_ed25519*
secrets.*

# --- Credential/token wildcard patterns ---
*token*
*password*

# --- VPN / Xray / 3X-UI specific ---
*vless*
*xray*
*3xui*
*webbasepath*

# --- AI_SECRETS folder (outside workspace — D:\AI_SECRETS) ---
AI_SECRETS/
../AI_SECRETS/

# ============================================================
# GIT HYGIENE — ADDED 2026-05-26
# ============================================================

# --- Node modules (largest noise source) ---
node_modules/
**/node_modules/

# --- Archive files ---
*.zip
*.7z
*.rar
*.tar
*.gz

# --- Backup files ---
*.bak
*.bak_*
*_backup*
*_backup_*
*.backup
*.BACKUP

# --- Temp / scratch / diagnostic root files ---
_diag_*.txt
_diag_*.json
_diag_*.ps1
_phase1_diag.txt
_smoke_out.txt
_tmp_*.txt
_import_out.txt
_backup_finalize_result.json
_mini_audit_diag_result.json

# --- Log files ---
*.log
*.tmp
*.pyc
__pycache__/

# --- Manifest and checksum files (generated) ---
*_manifest.txt
*.sha256.txt

# --- Cache / temp directories ---
.cache/
cache/
tmp/
temp/

# --- Obsidian local settings (UI state, not content) ---
.obsidian/

# --- Generated dashboard state (auto-rebuilt by tools) ---
09_dashboards/dashboard_state.json
09_dashboards/dashboard_state.bak_*.json

# --- 00_IMPORTS: large ChatGPT export raw data ---
00_IMPORTS/chatgpt_official_export_raw/
00_IMPORTS/chatgpt_official_export_extracted/

# --- 99_backups / 00_BACKUPS — local backup staging areas ---
99_backups/
00_BACKUPS/
99_EXPORTS/

# --- OS artifacts ---
Thumbs.db
.DS_Store
desktop.ini

# NOTE: D:\AI_BACKUPS is OUTSIDE the repository (D:\AI_WORKSPACE)
# and is never tracked by git — no rule needed, confirmed safe.

