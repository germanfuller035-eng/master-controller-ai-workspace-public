*secret*
*password*
*token*
*credentials*
# Android source files that match the broad secret patterns above but contain NO secrets
# (Keystore-API token STORAGE class — only pref key names, never token values). Tracked so a
# clean checkout of the branch compiles.
!apps/mater_controller_android/**/SecureTokenStore.kt
!apps/mater_controller_android/**/TokenRefresher.kt

