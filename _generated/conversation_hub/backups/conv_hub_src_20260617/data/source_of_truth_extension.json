{
  "schema": "conversation_hub.source_of_truth_extension.v1",
  "note": "MP3 — extends the Source of Truth Matrix for communication entities. Conversation Hub is NEVER the canonical writer of Master Controller-owned state. It owns only the normalized conversation VIEW and routing/draft RECOMMENDATIONS.",
  "synthetic": true,
  "entities": [
    { "entity": "canonical_identity", "system_of_record": "Master Controller", "readers": ["Conversation Hub", "Revenue OS", "Delivery OS", "Customer Success OS", "Analytics OS"], "writers": ["Master Controller"], "derived_views": ["Hub conversation.canonical_lead_id link"], "forbidden_writers": ["Conversation Hub", "Growth OS", "Lead Hunter"], "revision_policy": "MC revision; Hub links only on CANONICAL/STRONG evidence", "retention": "canonical (MC policy)", "conflict_resolution": "CONFLICT blocks Hub routing; owner review" },
    { "entity": "conversation", "system_of_record": "Conversation Hub", "readers": ["Owner", "Executive OS", "Analytics OS"], "writers": ["Conversation Hub"], "derived_views": ["owner inbox", "dashboard"], "forbidden_writers": ["channel adapters direct"], "revision_policy": "Hub revision int, bump on new message/identity change", "retention": "view-level; references canonical, stores no raw production body", "conflict_resolution": "new revision invalidates old summary" },
    { "entity": "thread", "system_of_record": "Conversation Hub", "readers": ["Owner", "Analytics OS"], "writers": ["Conversation Hub"], "derived_views": ["cross-channel conversation"], "forbidden_writers": ["channel adapters direct"], "revision_policy": "append messages; correlation evidence required", "retention": "view-level", "conflict_resolution": "ambiguous correlation -> MANUAL_REVIEW, never auto-merge" },
    { "entity": "message", "system_of_record": "channel adapter ingestion contract (future) -> normalized by Conversation Hub", "readers": ["Conversation Hub", "Analytics OS"], "writers": ["Conversation Hub normalizer (synthetic)"], "derived_views": ["classification", "routing"], "forbidden_writers": ["any direct network ingester in this task"], "revision_policy": "immutable normalized record + checksum; revisions are new records", "retention": "normalized + redacted; raw body NOT stored", "conflict_resolution": "dedupe outcome governs" },
    { "entity": "draft", "system_of_record": "Conversation Hub (draft REQUEST, send_allowed=false)", "readers": ["Owner", "Master Controller (future approval)"], "writers": ["Conversation Hub"], "derived_views": ["approval package"], "forbidden_writers": ["channel adapters"], "revision_policy": "draft revision; superseded on edit", "retention": "draft-level; never persisted to 13_sales", "conflict_resolution": "REVISION_CONFLICT blocks approval" },
    { "entity": "approval", "system_of_record": "Master Controller", "readers": ["Conversation Hub (reference)", "Owner", "Executive OS"], "writers": ["Master Controller"], "derived_views": ["Hub approval-request DISPLAY"], "forbidden_writers": ["Conversation Hub"], "revision_policy": "MC owns; Hub stores OWNER_*_REFERENCE only", "retention": "canonical (MC)", "conflict_resolution": "Hub never decides approval" },
    { "entity": "delivery_receipt", "system_of_record": "Master Controller (mail status / transport result)", "readers": ["Conversation Hub", "Analytics OS"], "writers": ["Master Controller"], "derived_views": ["Hub delivery_state on message"], "forbidden_writers": ["Conversation Hub"], "revision_policy": "transport accepted != delivered != replied", "retention": "canonical (MC)", "conflict_resolution": "UNKNOWN until reconciled" },
    { "entity": "bounce", "system_of_record": "Master Controller (mail status)", "readers": ["Conversation Hub", "Analytics OS"], "writers": ["Master Controller"], "derived_views": ["Hub bounce classification"], "forbidden_writers": ["Conversation Hub"], "revision_policy": "soft vs hard; hard may block future email recommendation", "retention": "canonical (MC)", "conflict_resolution": "bounce != identity invalid" },
    { "entity": "reply", "system_of_record": "Master Controller (reply_monitor)", "readers": ["Conversation Hub", "Analytics OS"], "writers": ["Master Controller"], "derived_views": ["Hub inbound message + routing recommendation"], "forbidden_writers": ["Conversation Hub"], "revision_policy": "MC reply state; Hub never mutates", "retention": "canonical (MC append-only)", "conflict_resolution": "Hub recommends route only" },
    { "entity": "opt_out", "system_of_record": "Master Controller (reply_monitor opt-out auto-stop)", "readers": ["Conversation Hub", "Growth OS", "Revenue OS", "Analytics OS"], "writers": ["Master Controller"], "derived_views": ["Hub opt-out recommendation (high priority)"], "forbidden_writers": ["Conversation Hub", "Growth OS"], "revision_policy": "evidence required; no automatic legal conclusion", "retention": "canonical (MC)", "conflict_resolution": "owner review required; recommendation only" },
    { "entity": "unsubscribe", "system_of_record": "Master Controller", "readers": ["Conversation Hub", "Growth OS"], "writers": ["Master Controller"], "derived_views": ["Hub opt-out recommendation"], "forbidden_writers": ["Conversation Hub"], "revision_policy": "treated as ALL_COMMERCIAL opt-out unless scoped", "retention": "canonical (MC)", "conflict_resolution": "owner review" },
    { "entity": "attachment_reference", "system_of_record": "File Vault (reference) + Conversation Hub link", "readers": ["Conversation Hub", "Owner"], "writers": ["File Vault", "Conversation Hub (reference only)"], "derived_views": ["message attachments[]"], "forbidden_writers": ["any binary duplicator in conversation store"], "revision_policy": "checksum-addressed reference; no binary duplication", "retention": "reference + metadata only", "conflict_resolution": "scan_status governs" },
    { "entity": "support_escalation", "system_of_record": "Customer Success OS", "readers": ["Conversation Hub", "Executive OS"], "writers": ["Customer Success OS"], "derived_views": ["Hub escalation queue recommendation"], "forbidden_writers": ["Conversation Hub"], "revision_policy": "CS lifecycle owns; Hub routes", "retention": "CS policy", "conflict_resolution": "high-risk -> Executive escalation recommendation" },
    { "entity": "channel_health", "system_of_record": "Conversation Hub (reference) + channel adapter (future runtime)", "readers": ["Owner", "Analytics OS"], "writers": ["Conversation Hub (reference)"], "derived_views": ["channel readiness panel"], "forbidden_writers": ["any live connector in this task"], "revision_policy": "NOT_CONNECTED in this task; never healthy from contract tests alone", "retention": "view-level", "conflict_resolution": "duplicate poller risk flagged" },
    { "entity": "communication_consent", "system_of_record": "Consent record with canonical evidence (Master Controller-linked)", "readers": ["Conversation Hub", "Growth OS", "Revenue OS"], "writers": ["Master Controller (canonical) via owner action"], "derived_views": ["Hub consent check on draft"], "forbidden_writers": ["Conversation Hub"], "revision_policy": "purpose+channel scoped; evidence required", "retention": "canonical", "conflict_resolution": "no consent -> draft blocked" },
    { "entity": "campaign_attribution", "system_of_record": "Growth OS (campaign) + Analytics OS (attribution)", "readers": ["Conversation Hub"], "writers": ["Growth OS", "Analytics OS"], "derived_views": ["Hub conversation.campaign_ids"], "forbidden_writers": ["Conversation Hub"], "revision_policy": "campaign_id reference only", "retention": "per owner system", "conflict_resolution": "reference only" }
  ]
}
