    "forbidden_fields": ["secret", "token", "password", "raw_authorization_header", "private_key", "complete_message_body", "unnecessary_email_phone", "financial_credential", "attachment_body"]
  },

  "audit_trail_standard": {
    "events": ["login_future", "secret_access_future", "approval", "canonical_mutation", "send", "status_change", "price_change", "product_promotion", "deployment", "restart", "backup", "restore", "deletion", "permission_grant", "security_exception", "incident_action"],
    "rules": ["audit trail not modifiable by derived UI", "no second outbound ledger", "append-only", "owner-readable"]
  }
}
