<?xml version="1.0" encoding="utf-8"?>
<!-- RELEASE/main: HTTPS only. No cleartext anywhere. Remote endpoints must be HTTPS. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
