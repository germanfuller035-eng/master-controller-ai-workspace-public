{
  "policy_id": "reply_monitor_policy_v1",
  "scope": "LOCAL_SYNTHETIC_ONLY",
  "required_fields": [
    "schema_version",
    "synthetic",
    "reply_id",
    "contact_id",
    "body",
    "source"
  ],
  "safety": {
    "OUTBOUND_EMAIL": "OFF",
    "OUTBOUND_SOCIAL": "OFF",
    "AUTO_SAFE": "OFF",
    "PAYMENTS": "OFF",
    "PRODUCTION_DB_WRITE": "OFF",
    "CRM_WRITE": "OFF",
    "INVOICE_SEND": "OFF",
    "ACCOUNTING_EXPORT": "OFF",
    "REAL_REPLY_MONITOR": "OFF"
  },
  "rules": {
    "synthetic_required": true,
    "real_inbox_access_allowed": false,
    "unsubscribe_triggers_suppression": true,
    "reply_monitor_required_before_future_activation": true
  }
}
