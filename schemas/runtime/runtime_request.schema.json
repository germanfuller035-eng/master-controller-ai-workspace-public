{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Runtime Request",
  "type": "object",
  "additionalProperties": true,
  "required": ["task_id", "actor", "purpose", "risk", "budget", "model_requirement", "tool_scope"],
  "properties": {
    "task_id": {"type": "string", "minLength": 1},
    "actor": {"type": "string", "minLength": 1},
    "purpose": {"type": "string", "minLength": 1},
    "risk": {"type": "string", "enum": ["R0", "R1", "R2", "R3", "R4", "R5"]},
    "environment": {"type": "string", "enum": ["LOCAL_SYNTHETIC", "PRODUCTION", "SHADOW"]},
    "local_synthetic_fixture": {"type": "boolean"},
    "budget": {"type": "object"},
    "model_requirement": {"type": "object"},
    "tool_scope": {"type": "object"}
  }
}
