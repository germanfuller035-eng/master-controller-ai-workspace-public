{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Foundation Feature Flags",
  "type": "object",
  "required": ["schema_version", "generated_at", "session", "registry_kind", "feature_flags"],
  "properties": {
    "registry_kind": {"const": "feature_flags"},
    "default_state": {"const": "OFF"},
    "feature_flags": {
      "type": "array",
      "items": {"$ref": "#/$defs/foundationEntry"}
    }
  },
  "$defs": {
    "foundationEntry": {
      "type": "object",
      "required": ["id", "purpose", "owner", "status", "allowed_lifecycle", "current_lifecycle", "allowed_tools", "denied_capabilities", "data_classes", "risk_max", "approval_requirement", "tests_required", "rollback_note", "review_date", "source_provenance", "initial_state", "promotion_criteria", "rollback", "evidence_required"],
      "properties": {
        "id": {"type": "string"},
        "initial_state": {"const": "OFF"},
        "current_lifecycle": {"const": "OFF"},
        "risk_max": {"enum": ["R0", "R1", "R2", "R3", "R4", "R5"]}
      }
    }
  }
}
