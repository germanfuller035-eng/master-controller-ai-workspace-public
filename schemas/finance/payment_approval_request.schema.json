{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schemas/finance/payment_approval_request.schema.json",
  "title": "Payment Approval Request V1",
  "type": "object",
  "required": [
    "schema_version",
    "synthetic",
    "approval_required",
    "payload_hash",
    "execution_allowed"
  ],
  "properties": {
    "schema_version": {"const": "finance.payment_approval_request.v1"},
    "synthetic": {"const": true},
    "approval_required": {"const": true},
    "payload_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "execution_allowed": {"const": false}
  },
  "additionalProperties": true
}
