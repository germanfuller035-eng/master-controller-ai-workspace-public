{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schemas/controlled_outbound/outbound_draft.schema.json",
  "title": "Outbound Draft V1",
  "type": "object",
  "required": [
    "schema_version",
    "synthetic",
    "draft_id",
    "contact_id",
    "channel",
    "draft_only",
    "send_allowed",
    "payload_hash"
  ],
  "properties": {
    "schema_version": {"const": "controlled_outbound.outbound_draft.v1"},
    "synthetic": {"const": true},
    "draft_id": {"type": "string"},
    "contact_id": {"type": "string"},
    "channel": {"type": "string"},
    "draft_only": {"const": true},
    "send_allowed": {"const": false},
    "payload_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "additionalProperties": true
}
