{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schemas/controlled_outbound/no_send_shadow_result.schema.json",
  "title": "No Send Shadow Result V1",
  "type": "object",
  "required": [
    "synthetic",
    "status",
    "outbound_count",
    "payment_count",
    "production_db_writes",
    "send_allowed"
