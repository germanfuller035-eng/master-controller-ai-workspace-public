{
  "$schema": "urn:json-schema:draft-2020-12",
  "$id": "urn:master-controller:schemas:digital_presence:prototype_artifact",
  "title": "prototype_artifact",
  "type": "object",
  "additionalProperties": true,
  "required": ["artifact_id", "artifact_type", "sha256"],
  "properties": {
    "artifact_id": {"type": "string"},
    "artifact_type": {"type": "string"},
    "path": {"type": "string"},
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "hash_algorithm": {"const": "SHA-256"},
    "draft_only": {"type": "boolean"},
    "deployment_allowed": {"type": "boolean"},
    "owner_approval_required_for_future_deploy_or_send": {"type": "boolean"}
  }
}
