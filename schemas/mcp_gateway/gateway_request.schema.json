{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MCP Gateway Request",
  "type": "object",
  "additionalProperties": true,
  "required": ["request_id", "task_id", "actor", "adapter_id", "action", "resource", "environment", "risk", "data_class", "input", "timeout_ms", "evidence_required"],
  "properties": {
    "request_id": {"type": "string", "minLength": 1},
    "task_id": {"type": "string", "minLength": 1},
    "actor": {"type": "string", "minLength": 1},
    "adapter_id": {"type": "string", "minLength": 1},
    "action": {"type": "string", "minLength": 1},
    "resource": {"type": "string"},
    "environment": {"type": "string", "enum": ["OFF", "LOCAL_SYNTHETIC", "SHADOW", "PRODUCTION_READ_ONLY", "DRAFT_ONLY", "OWNER_APPROVAL_REQUIRED", "LIMITED_AUTONOMY", "PRODUCTION"]},
    "risk": {"type": "string", "enum": ["R0", "R1", "R2", "R3", "R4", "R5"]},
    "data_class": {"type": "string"},
    "input": {"type": "object"},
    "approval": {"type": ["object", "null"]},
    "timeout_ms": {"type": "integer", "minimum": 1},
    "cancellation_token": {"type": ["object", "string", "null"]},
    "evidence_required": {"type": "boolean"}
  }
}
